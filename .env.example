# ==============================================================================
# CONFIGURACIÓN DE ENTORNO — REGALOS EXCLUSIVOS
# ==============================================================================
# Copia este archivo como .env.local y completa tus credenciales de Supabase y Resend.

# 1. SUPABASE (Obtenidos en Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# 2. CREDENCIALES DE ACCESO AL PANEL DE ADMINISTRADOR (/admin)
NEXT_PUBLIC_ADMIN_EMAIL=admin@tudominio.com
NEXT_PUBLIC_ADMIN_PASSWORD=admin123

# 3. AUTOMATIZACIÓN DE CORREOS ELECTRÓNICOS (Gratis en resend.com: 3,000/mes)
RESEND_API_KEY=
EMAIL_FROM=REGALOS EXCLUSIVOS <onboarding@resend.dev>

# 4. AUTOMATIZACIÓN DE WHATSAPP (Opcional: n8n, Make.com, Zapier o Evolution API)
WHATSAPP_WEBHOOK_URL=
